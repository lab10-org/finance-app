# Copia este archivo a .env.local y complétalo. .env.local está en .gitignore.
#
# Los dos valores salen de `supabase status`, que los imprime después de
# `supabase start`. Ver README.md, "Stack local de Supabase".

# La API del stack local. Es siempre la misma.
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321

# La llave pública ("anon key"). Se genera por proyecto, así que aquí va vacía:
# tómala de la salida de `supabase status`.
NEXT_PUBLIC_SUPABASE_ANON_KEY=
